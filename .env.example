# Required. Loopback for local; Compose/Docker set 0.0.0.0.
HOST=127.0.0.1

# Required.
PORT=3000

# Required. debug | info | warn | error
LOG_LEVEL=info

# Required. Drain timeout on SIGTERM/SIGINT/fatal.
SHUTDOWN_TIMEOUT_MS=10000

# Comma-separated hostnames, port-agnostic. Required when HOST is not loopback.
# On loopback this defaults to localhost,127.0.0.1,::1.
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Optional. Same parse as hosts. Requests with no Origin still pass.
# MCP_ALLOWED_ORIGINS=localhost,127.0.0.1

# Optional. Empty or unset disables Sentry; the process still starts.
# SENTRY_DSN=

# Optional. Staging vs prod. Defaults to production.
# SENTRY_ENVIRONMENT=production

# Optional. Deploy id. Defaults to package.json version.
# SENTRY_RELEASE=0.1.0

# Optional. 0..1. Defaults to 0.1 when SENTRY_DSN is set.
# SENTRY_TRACES_SAMPLE_RATE=0.1
